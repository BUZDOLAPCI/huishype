# HuisHype Production Environment Variables
# Copy to .env.production and fill in values, or set in Coolify UI.

# ── Database ──
DB_USER=huishype
DB_PASSWORD=          # REQUIRED: strong random password
DB_NAME=huishype

# Martin uses a separate read-only Postgres role with short statement timeout.
# Create/grant it with tools/martin/readonly-role.sql and replace the password.
MARTIN_DATABASE_URL=postgresql://martin_tile:REPLACE_ME@postgres:5432/huishype?sslmode=disable&options=-c%20statement_timeout%3D2000
MARTIN_URL=http://martin:3111

# ── Auth secrets ──
JWT_SECRET=           # REQUIRED: openssl rand -hex 32
JWT_REFRESH_SECRET=   # REQUIRED: openssl rand -hex 32
COOKIE_SECRET=        # REQUIRED: openssl rand -hex 32
TILE_SESSION_SECRET=  # REQUIRED: openssl rand -hex 32

# ── Web app (build-time) ──
EXPO_PUBLIC_API_URL=  # REQUIRED: e.g. https://api.huishype.nl

# ── CORS (comma-separated origins, defaults to huishype.nl + huishype.com) ──
CORS_ORIGINS=         # e.g. https://huishype.nl,https://app.huishype.nl

# ── Email (magic links via Resend, domain: huishype.nl verified) ──
MAGIC_LINK_BASE_URL=https://huishype.nl/auth/callback
RESEND_API_KEY=      # from .env.resend
EMAIL_FROM=HuisHype <noreply@huishype.nl>
EMAIL_REPLY_TO=support@huishype.nl

# ── Google OAuth (required for web-only release) ──
GOOGLE_CLIENT_ID=91432986388-5qlnvk7ab5kncff4j9prms4qnec10tiq.apps.googleusercontent.com
# APPLE_CLIENT_ID=nl.huishype.app  # Deferred — not used in web-only release

# ── Listing ingest + source services ──
# These are required by docker-compose.prod.yml for both api and worker.
# Use scraper VM private-network URLs. Current production private network:
# app/prod VM 10.42.0.10 -> scraper VM 10.42.0.2.
INGEST_API_KEY=                         # REQUIRED: shared secret for scraper callbacks and ingest routes
FUNDA_SOURCE_SERVICE_URL=http://10.42.0.2:8100
FUNDA_SOURCE_SERVICE_API_KEY=           # REQUIRED: shared secret accepted by the Funda source service
PARARIUS_SOURCE_SERVICE_URL=http://10.42.0.2:8101
PARARIUS_SOURCE_SERVICE_API_KEY=        # REQUIRED: shared secret accepted by the Pararius source service
