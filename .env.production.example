# HuisHype Production Environment Variables
# Copy to .env.production and fill in values, or set in Coolify UI.

# ── Database ──
DB_USER=huishype
DB_PASSWORD=          # REQUIRED: strong random password
DB_NAME=huishype

# ── Auth secrets ──
JWT_SECRET=           # REQUIRED: openssl rand -hex 32
JWT_REFRESH_SECRET=   # REQUIRED: openssl rand -hex 32
COOKIE_SECRET=        # REQUIRED: openssl rand -hex 32

# ── Web app (build-time) ──
EXPO_PUBLIC_API_URL=  # REQUIRED: e.g. https://api.huishype.nl

# ── CORS (comma-separated origins, defaults to huishype.nl + huishype.com) ──
CORS_ORIGINS=         # e.g. https://huishype.nl,https://app.huishype.nl

# ── Email (magic links) ──
MAGIC_LINK_BASE_URL=  # e.g. https://huishype.nl/auth
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=

# ── OAuth (optional) ──
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=
