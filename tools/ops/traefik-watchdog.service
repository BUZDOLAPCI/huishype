[Unit]
Description=Traefik routing watchdog for HuisHype
After=network-online.target
After=docker.service
Requires=docker.service
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=-/etc/default/traefik-watchdog
StateDirectory=traefik-watchdog
ExecStart=/usr/local/bin/traefik-watchdog.sh
