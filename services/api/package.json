{
  "name": "@huishype/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint . --max-warnings=0",
    "test": "NODE_ENV=test NODE_OPTIONS='--experimental-vm-modules' jest --runInBand --testPathIgnorePatterns='__tests__/integration'",
    "test:unit": "NODE_ENV=test NODE_OPTIONS='--experimental-vm-modules' jest --runInBand --testPathIgnorePatterns='__tests__/integration'",
    "test:integration": "NODE_ENV=test NODE_OPTIONS='--experimental-vm-modules' jest --runInBand --testPathPattern='__tests__/integration' --testTimeout=15000",
    "test:all": "NODE_ENV=test NODE_OPTIONS='--experimental-vm-modules' jest",
    "typecheck": "tsc --noEmit",
    "openapi:export": "tsx scripts/export-openapi.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx scripts/seed.ts",
    "db:seed-listings": "tsx scripts/seed-listings.ts",
    "db:seed-test-fixture": "tsx scripts/seed-test-fixture.ts",
    "db:reset": "tsx scripts/db-reset.ts",
    "db:rebuild-location-search-areas": "tsx src/scripts/rebuild-location-search-areas.ts",
    "db:seed-landcover": "tsx src/scripts/import-landcover.ts",
    "db:seed-watercover": "tsx src/scripts/import-watercover.ts",
    "db:seed-tall-buildings": "tsx src/scripts/import-tall-buildings.ts",
    "db:import-buildings": "tsx src/scripts/import-osm-buildings.ts",
    "db:seed-overture": "tsx src/scripts/import-overture-addresses.ts",
    "sprites:paper": "tsx src/scripts/build-paper-sprites.ts",
    "ingest:recover": "tsx src/scripts/ingest-recovery.ts",
    "pyramid:rollback": "tsx scripts/property-tile-pyramid-rollback.ts",
    "benchmark:property-tiles": "tsx scripts/benchmark-property-tiles.ts",
    "benchmark:property-tiles:gate": "tsx scripts/benchmark-property-tiles.ts --warm-passes 1 --fail-cold-gen-over-ms 2200 --fail-cold-p95-gen-over-ms 2000",
    "validate:property-tiles": "tsx scripts/validate-property-tile-semantics.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1067.0",
    "@fastify/compress": "^8.3.1",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/jwt": "^10.1.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.4",
    "@huishype/shared": "workspace:*",
    "better-sqlite3": "^12.10.0",
    "bullmq": "^5.78.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.8.5",
    "fastify-plugin": "^5.1.0",
    "fastify-type-provider-zod": "^6.1.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "postgres": "^3.4.9",
    "proj4": "^2.20.9",
    "sharp": "^0.35.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@mapbox/vector-tile": "^2.0.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "drizzle-kit": "^0.31.10",
    "jest": "^29.7.0",
    "pbf": "^4.0.1",
    "ts-jest": "^29.4.11",
    "tsx": "^4.22.4",
    "typescript": "^5.7.3"
  }
}
